# ═══════════════════════════════════════════════════════════
# trace-mind-ai 配置模板
# 用法：cp .env.example .env   然后把占位符换成真实值
# ═══════════════════════════════════════════════════════════

# ───── 运行环境 ─────
# dev | staging | prod
# prod 会强制校验：LOG_FORMAT=json 且 SERVER_DEBUG=false
ENVIRONMENT=dev

# ───── 大模型（★ 必填）─────
# 兼容 OpenAI 协议的任何服务商都可以，只改这三行
# DeepSeek:  https://api.deepseek.com/v1        模型 deepseek-chat
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 智谱:      https://open.bigmodel.cn/api/paas/v4  模型 glm-4-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me-with-your-real-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# 单次诊断最多允许的模型调用次数 —— 这是成本闸门，别调太大
LLM_MAX_CALLS_PER_DIAGNOSIS=12

# ───── Elasticsearch ─────
ES_HOSTS=http://192.168.100.128:9200
ES_INDEX_LOGS=log_entry
ES_REQUEST_TIMEOUT_S=5

# ───── Redis ─────
REDIS_URL=redis://:123456@192.168.100.128:6379/0

# ───── MySQL（★ 必填）─────
# 注意：这里要的是 SQLAlchemy 的 async DSN，驱动用 asyncmy
MYSQL_DSN=mysql+asyncmy://root:123456@192.168.100.128:3306/tracemind?charset=utf8mb4
MYSQL_ECHO=false

# ───── 向量库（本地持久化）─────
CHROMA_PERSIST_DIR=./.data/chroma
CHROMA_COLLECTION=diagnosis_cases

# ───── 服务 ─────
# ★ 默认只监听 127.0.0.1：这个服务持有 API Key，不要默认对外
SERVER_HOST=127.0.0.1
SERVER_PORT=8100
SERVER_DEBUG=false

# ───── 日志 ─────
# console = 人看，json = 采集器看（生产必须 json）
LOG_LEVEL=INFO
LOG_FORMAT=console

# ───── 单轮处理预算（与 Java 侧采集模块的预算对齐）─────
BUDGET_MAX_LOG_ROWS=5000
BUDGET_MAX_DURATION_S=10